# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Reference Drug API
REFERENCE_DRUG_API_URL=https://685daed17b57aebd2af6da54.mockapi.io/api/v1/drugs

# File Upload Limits
MAX_FILE_SIZE=10485760
MAX_FILES_PER_REQUEST=1

# Logging
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# Cache Configuration
REFERENCE_DRUG_CACHE_DURATION=300000
